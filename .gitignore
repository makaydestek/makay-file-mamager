APK/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Gradle artıkları (asla commit edilmez)
/android/build/
**/.gradle/
*.hprof

# Widget Preview related
.widget_preview/

# --- E2E (integration_test) bilinçli olarak KALDIRILDI ---
