<?xml version="1.0" encoding="utf-8"?>
<!-- Otomatik güncelleme APK'sının paylaşılan yolları (FileProvider). -->
<paths>
    <files-path name="internal_files" path="."/>
    <cache-path name="cache_files" path="."/>
    <external-files-path name="external_files" path="."/>
    <!-- Kullanıcının indirdiği APK'lar (/storage/emulated/0/Download vb.)
         FileProvider ile paylaşılamazsa kur ekranı açılamaz. -->
    <external-path name="external_storage" path="."/>
</paths>
